#!/usr/bin/env bash
# 기본 Node 버전과 상관없이 Node 24 이상으로 Switchboard CLI를 실행한다.
# 원하면: ln -s ~/project/switchboard/scripts/switchboard ~/.local/bin/switchboard
set -euo pipefail
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
node_bin=""
for d in $(ls -d "$HOME"/.nvm/versions/node/v2[4-9].*/bin 2>/dev/null | sort -V -r); do
  node_bin="$d/node"; break
done
exec "${node_bin:-node}" "$root/apps/daemon/bin/switchboard.js" "$@"

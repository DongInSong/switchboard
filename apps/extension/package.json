{
  "name": "@switchboard/extension",
  "version": "0.2.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "wxt build -b edge",
    "build:chrome": "wxt build -b chrome",
    "zip": "wxt zip -b edge",
    "postinstall": "wxt prepare",
    "build:e2e": "WXT_E2E=1 wxt build -b chrome",
    "e2e": "pnpm build:e2e && node e2e/smoke.mjs",
    "sync:windows": "node scripts/sync-windows.mjs"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@switchboard/page-probe": "workspace:*",
    "@switchboard/protocol": "workspace:*",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "wxt": "^0.21.5"
  }
}
